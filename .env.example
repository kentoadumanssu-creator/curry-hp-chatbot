# ========================================
# Vercel 環境変数サンプル
# ========================================
# このファイルをコピーして .env.local を作り、
# ローカルテスト時に使用してください。
# 本番は Vercel ダッシュボードで設定します。
# ========================================

# Anthropic Claude API キー
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# 予約メール送信用（Gmail）
# ========================================
# 送信元にする Gmail アドレス
GMAIL_USER=your-account@gmail.com

# 上記アカウントで発行した「アプリパスワード」（16桁・スペースなし）
# 発行方法: https://myaccount.google.com/apppasswords
# （2段階認証を有効にしてから発行してください）
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 予約リクエストの届け先メールアドレス（店舗側）
RESERVATION_TO_EMAIL=anoji0713@gmail.com
