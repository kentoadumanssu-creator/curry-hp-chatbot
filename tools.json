        "date": { "type": "string", "description": "ご希望日（例: 2026年7月20日）" },
        "time": { "type": "string", "description": "ご希望時間（例: 18:30）" },
        "party_size": { "type": "string", "description": "人数（例: 2名）" },
        "phone": { "type": "string", "description": "当日連絡のつく電話番号" },
        "notes": { "type": "string", "description": "アレルギーや席の希望など（任意。なければ空文字でよい）" }
      },
      "required": ["name", "date", "time", "party_size", "phone"]
    }
  }
]
